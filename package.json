{
	"name": "mharj-diskinfo",
	"version": "0.2.2",
	"description": "Node.js library to parse MBR and GPT partition information from disk images or devices.",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		"import": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"require": {
			"types": "./dist/index.d.cts",
			"default": "./dist/index.cjs"
		},
		"default": "./dist/index.mjs"
	},
	"scripts": {
		"prepare": "lefthook install",
		"build": "tsdown src/index.ts --format cjs,esm --dts --clean -c tsconfig.build.json",
		"prepublishOnly": "npm run build",
		"test": "vitest test --typecheck --run --no-isolate --coverage",
		"coverage": "vitest test --run --no-isolate --reporter=dot --coverage --coverage.reporter=lcov",
		"lint": "biome check",
		"validate": "tsgo --noEmit"
	},
	"repository": "github:mharj/diskinfo",
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=10.4.0"
	},
	"author": "mharj",
	"license": "LGPL",
	"bugs": {
		"url": "https://github.com/mharj/diskinfo/issues"
	},
	"homepage": "https://github.com/mharj/diskinfo#readme",
	"devDependencies": {
		"@biomejs/biome": "^2.5.0",
		"@tsconfig/node16": "^16.1.8",
		"@types/node": "^22.19.21",
		"@typescript/native-preview": "7.0.0-dev.20260616.1",
		"@vitest/coverage-v8": "^4.1.9",
		"buffer-crc32": "^1.0.0",
		"c8": "^11.0.0",
		"lefthook": "^2.1.9",
		"tsdown": "^0.22.3",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.9"
	},
	"packageManager": "pnpm@10.34.3+sha512.f2c531b08829d7be7f03c90addc266615f9c5477463e4bf1d275cb263ce9ea57cf0d5599110d94649a9bb3fed9f0b5efcea74a7016b61532a24cb9ad87860c1d"
}
