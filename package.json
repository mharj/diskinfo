{
	"name": "mharj-diskinfo",
	"version": "0.2.2",
	"description": "Node.js library to parse MBR and GPT partition information from disk images or devices.",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		"import": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"require": {
			"types": "./dist/index.d.cts",
			"default": "./dist/index.cjs"
		},
		"default": "./dist/index.mjs"
	},
	"scripts": {
		"prepare": "lefthook install",
		"build": "tsdown src/index.ts --format cjs,esm --dts --clean -c tsconfig.build.json",
		"prepublishOnly": "npm run build",
		"test": "vitest test --typecheck --run --no-isolate --coverage",
		"coverage": "vitest test --run --no-isolate --reporter=dot --coverage --coverage.reporter=lcov",
		"lint": "biome check",
		"validate": "tsc --noEmit"
	},
	"repository": "github:mharj/diskinfo",
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=10.4.0"
	},
	"author": "mharj",
	"license": "LGPL",
	"bugs": {
		"url": "https://github.com/mharj/diskinfo/issues"
	},
	"homepage": "https://github.com/mharj/diskinfo#readme",
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@tsconfig/node16": "^16.1.9",
		"@types/node": "^22.20.4",
		"@vitest/coverage-v8": "^5.0.2",
		"buffer-crc32": "^1.0.0",
		"c8": "^12.0.0",
		"lefthook": "^2.1.15",
		"tsdown": "^0.23.0",
		"tslib": "^2.8.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.1",
		"vitest": "^5.0.2"
	},
	"packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45"
}
